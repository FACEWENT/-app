<view class="page">
  <!-- 笔记详情 -->
  <view class="note-detail" wx:if="{{note}}">
    <!-- 图片轮播 -->
    <swiper class="image-swiper" wx:if="{{note.images && note.images.length > 0}}" indicator-dots autoplay>
      <swiper-item wx:for="{{note.images}}" wx:key="index">
        <image class="swiper-image" src="{{item}}" mode="aspectFit" bindtap="onPreviewImage" data-images="{{note.images}}" data-index="{{index}}"/>
      </swiper-item>
    </swiper>

    <!-- 作者信息 -->
    <view class="author-section">
      <image class="author-avatar" src="{{note.avatar_url ? note.avatar_url : '/images/default-avatar.png'}}" mode="aspectFill"/>
      <view class="author-info">
        <text class="author-name">{{note.nickname}}</text>
        <text class="publish-time">{{note.created_at_str}}</text>
      </view>
      <view class="follow-btn" wx:if="{{!isAuthor}}">
        <text>关注</text>
      </view>
    </view>

    <!-- 标题 -->
    <view class="title-section">
      <text class="title">{{note.title}}</text>
    </view>

    <!-- 内容 -->
    <view class="content-section">
      <text class="content">{{note.content}}</text>
    </view>

    <!-- 标签 -->
    <view class="tags-section" wx:if="{{note.tags_list && note.tags_list.length > 0}}">
      <text class="tag" wx:for="{{note.tags_list}}" wx:key="index" wx:for-item="tag">#{{tag}}</text>
    </view>

    <!-- 分类 -->
    <view class="category-section" wx:if="{{note.category}}">
      <text class="category-tag">{{note.category}}</text>
    </view>

    <!-- 统计信息 -->
    <view class="stats-section">
      <text class="stat-item">👁 {{note.view_count}} 浏览</text>
      <text class="stat-item">❤ {{note.like_count}} 点赞</text>
      <text class="stat-item">⭐ {{note.collect_count}} 收藏</text>
      <text class="stat-item">💬 {{note.comment_count}} 评论</text>
    </view>
  </view>

  <!-- 评论区 -->
  <view class="comments-section">
    <view class="section-title">评论 ({{note ? note.comment_count : 0}})</view>
    
    <view class="comment-item" wx:for="{{note ? note.comments : []}}" wx:key="id">
      <image class="comment-avatar" src="{{item.avatar_url ? item.avatar_url : '/images/default-avatar.png'}}" mode="aspectFill"/>
      <view class="comment-content">
        <text class="comment-user">{{item.nickname}}</text>
        <text class="comment-text">{{item.content}}</text>
        <text class="comment-time">{{item.created_at}}</text>
      </view>
    </view>

    <view class="no-comments" wx:if="{{note && note.comments.length === 0}}">
      <text>暂无评论，快来抢沙发吧</text>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="action-btn" bindtap="onComment">
      <text>💬</text>
      <text>评论</text>
    </view>
    <view class="action-btn {{note && note.is_liked ? 'liked' : ''}}" bindtap="onLike">
      <text>{{note && note.is_liked ? '❤️' : '🤍'}}</text>
      <text>{{note ? note.like_count : 0}}</text>
    </view>
    <view class="action-btn {{note && note.is_collected ? 'collected' : ''}}" bindtap="onCollect">
      <text>{{note && note.is_collected ? '⭐' : '☆'}}</text>
      <text>{{note ? note.collect_count : 0}}</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
