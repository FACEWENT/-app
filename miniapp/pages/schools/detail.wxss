.page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 40rpx;
}

/* 学校头部 */
.school-header {
  background: linear-gradient(135deg, #0f766e 0%, #0f2a43 100%);
  padding: 40rpx 30rpx;
  color: #fff;
}

.school-name {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 15rpx;
}

.school-location {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 20rpx;
}

.school-levels {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.level-tag {
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.2);
}

.tag-985 {
  background: rgba(239, 68, 68, 0.8);
}

.tag-211 {
  background: rgba(245, 158, 11, 0.8);
}

.tag-double {
  background: rgba(59, 130, 246, 0.8);
}

.tag-type {
  background: rgba(139, 92, 246, 0.8);
}

.tag-self {
  background: rgba(16, 185, 129, 0.8);
}

.school-ranking {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 统计概览 */
.stats-section {
  display: flex;
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #0f766e;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

/* 通用section */
.section {
  background: #fff;
  margin-bottom: 20rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 25rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.section-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

/* 专业卡片 */
.program-card {
  background: #f9fafb;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.program-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 25rpx;
}

.program-info {
  flex: 1;
}

.program-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.program-code {
  font-size: 24rpx;
  color: #999;
}

.program-toggle {
  font-size: 30rpx;
  color: #999;
  margin-left: 20rpx;
}

/* 专业详情 */
.program-detail {
  padding: 0 25rpx 25rpx;
}

.info-grid {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.info-item {
  flex: 1;
  background: #fff;
  padding: 20rpx;
  border-radius: 8rpx;
  text-align: center;
}

.info-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

/* 详情块 */
.detail-block {
  background: #fff;
  padding: 20rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.block-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.block-content {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.subject-item,
.book-item {
  background: #f0fdfa;
  color: #0f766e;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.book-item {
  background: #fef3c7;
  color: #92400e;
}

/* 历年数据 */
.history-section {
  background: #fff;
  padding: 20rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.history-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

/* 表格 */
.history-table {
  background: #f9fafb;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.table-header,
.table-row {
  display: flex;
  border-bottom: 1rpx solid #eee;
}

.table-header {
  background: #f0fdfa;
  font-weight: bold;
}

.table-row:last-child {
  border-bottom: none;
}

.cell {
  flex: 1;
  padding: 15rpx 10rpx;
  text-align: center;
  font-size: 24rpx;
  color: #666;
}

.cell.year {
  flex: 0.8;
  font-weight: bold;
  color: #333;
}

/* 分数详情 */
.score-detail {
  background: #f9fafb;
  padding: 20rpx;
  border-radius: 8rpx;
  margin-bottom: 15rpx;
}

.detail-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.score-grid {
  display: flex;
  gap: 15rpx;
}

.score-item {
  flex: 1;
  text-align: center;
  background: #fff;
  padding: 15rpx;
  border-radius: 8rpx;
}

.score-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.score-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #0f766e;
}

/* 底部链接 */
.bottom-links {
  padding: 0 30rpx;
}

.link-item {
  background: #fff;
  padding: 30rpx;
  border-radius: 12rpx;
  text-align: center;
  margin-bottom: 15rpx;
  color: #0f766e;
  font-size: 28rpx;
}

/* 加载中 */
.loading-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}
