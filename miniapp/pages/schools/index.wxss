.page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 40rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.search-input {
  flex: 1;
  height: 70rpx;
  background: #f5f7fa;
  border-radius: 35rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

.search-btn {
  margin-left: 20rpx;
  padding: 15rpx 30rpx;
  background: #0f766e;
  color: #fff;
  border-radius: 35rpx;
  font-size: 28rpx;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.filter-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  font-size: 26rpx;
  color: #666;
}

.filter-item.active {
  color: #0f766e;
  font-weight: bold;
}

.filter-item .arrow {
  margin-left: 8rpx;
  font-size: 20rpx;
}

/* 筛选面板 */
.filter-panel {
  position: fixed;
  top: 310rpx;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.filter-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.panel-content {
  position: relative;
  background: #fff;
  max-height: 500rpx;
  overflow-y: auto;
  padding: 20rpx;
}

.panel-item {
  padding: 25rpx 30rpx;
  font-size: 28rpx;
  color: #333;
  border-bottom: 1rpx solid #f5f5f5;
}

.panel-item.selected {
  color: #0f766e;
  font-weight: bold;
  background: #f0fdfa;
}

/* 已选筛选条件 */
.active-filters {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 30rpx;
  background: #fff;
  margin-bottom: 10rpx;
}

.filter-tag {
  display: flex;
  align-items: center;
  background: #f0fdfa;
  color: #0f766e;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  margin-right: 15rpx;
  margin-bottom: 10rpx;
}

.tag-close {
  margin-left: 10rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.clear-all {
  color: #999;
  font-size: 24rpx;
  padding: 10rpx 20rpx;
}

/* 统计栏 */
.stats-bar {
  padding: 20rpx 30rpx;
  background: #fff;
}

.stats-text {
  font-size: 26rpx;
  color: #666;
}

/* 院校列表 */
.school-list {
  padding: 0 30rpx;
}

.school-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  position: relative;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.school-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 15rpx;
}

.school-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.school-ranking {
  font-size: 24rpx;
  color: #0f766e;
  background: #f0fdfa;
  padding: 5rpx 15rpx;
  border-radius: 20rpx;
}

.school-location {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 15rpx;
}

.school-levels {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 15rpx;
}

.level-tag {
  padding: 5rpx 15rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #fff;
}

.tag-985 {
  background: #ef4444;
}

.tag-211 {
  background: #f59e0b;
}

.tag-double {
  background: #3b82f6;
}

.tag-type {
  background: #8b5cf6;
}

.school-intro {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.school-arrow {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 40rpx;
  color: #ccc;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx;
  font-size: 26rpx;
  color: #999;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 30rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 15rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
}

/* 加载中 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.loading-spinner {
  font-size: 28rpx;
  color: #0f766e;
}
