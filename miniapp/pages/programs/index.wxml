<view class="page">
  <view class="hero">
    <view class="hero-title">专业库</view>
    <view class="hero-subtitle">按专业代码和专业名快速定位目标方向</view>
  </view>

  <view class="card">
    <view class="section-title">搜索专业</view>
    <input class="input" style="min-height: 88rpx;" placeholder="输入专业名称或代码，例如 085404" bindinput="onKeywordChange" value="{{keyword}}" />
    <button class="button" bindtap="onSearch">搜索</button>
  </view>

  <view class="card">
    <view class="section-title">专业列表</view>
    <view class="list-item" wx:for="{{programs}}" wx:key="id">
      <view class="item-title">{{item.name}}</view>
      <view class="muted" style="margin-top: 12rpx;">专业代码：{{item.code}}</view>
      <view class="tag-row">
        <view class="tag">{{item.discipline_name}}</view>
        <view class="tag">{{item.degree_type}}</view>
        <view class="tag">{{item.learning_mode}}</view>
      </view>
    </view>
  </view>
</view>
