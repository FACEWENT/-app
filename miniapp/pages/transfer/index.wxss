.page {
  min-height: 100vh;
  background: linear-gradient(to bottom, #edf5ff, #f8fafc);
  padding: 32rpx 28rpx 40rpx;
}

.hero {
  background: linear-gradient(135deg, #0f766e, #0f2a43);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 118, 110, 0.2);
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.hero-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #112132;
  margin-bottom: 24rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.label {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 12rpx;
}

.input {
  height: 88rpx;
  background: #f1f5f9;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #112132;
}

.picker {
  height: 88rpx;
  background: #f1f5f9;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #112132;
  line-height: 88rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 12rpx 24rpx;
  background: #f1f5f9;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #64748b;
}

.tag.selected {
  background: #0f766e;
  color: #ffffff;
}

/* A区/B区快捷选择 */
.area-quick-select {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.area-btn {
  flex: 1;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f1f5f9;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #64748b;
  font-weight: bold;
}

.area-btn.active {
  background: #0f766e;
  color: #fff;
}

/* 地区分组 */
.province-group {
  margin-bottom: 20rpx;
}

.group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15rpx 0;
  background: #f8fafc;
  border-radius: 12rpx;
  margin-bottom: 15rpx;
  padding: 20rpx;
}

.group-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.group-arrow {
  font-size: 24rpx;
  color: #999;
}

/* 已选地区 */
.selected-provinces {
  display: flex;
  align-items: flex-start;
  padding: 20rpx;
  background: #f0fdfa;
  border-radius: 12rpx;
  margin-top: 20rpx;
}

.selected-label {
  font-size: 26rpx;
  color: #0f766e;
  font-weight: bold;
  margin-right: 15rpx;
  white-space: nowrap;
}

.selected-list {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.selected-tag {
  display: flex;
  align-items: center;
  background: #0f766e;
  color: #fff;
  padding: 8rpx 15rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.tag-remove {
  margin-left: 8rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.btn-container {
  margin: 32rpx 0;
}

.button {
  background: linear-gradient(135deg, #0f766e, #0d5f59);
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 0;
}

.button[disabled] {
  opacity: 0.7;
}

/* 调剂指南 */
.guide-item {
  padding: 16rpx 0;
}

.guide-text {
  font-size: 26rpx;
  color: #475569;
  line-height: 1.6;
}

.guide-text.tip {
  color: #0f766e;
}

.guide-text.note {
  color: #dc2626;
}

.guide-divider {
  height: 1rpx;
  background: #e2e8f0;
  margin: 16rpx 0;
}

/* 结果列表 */
.summary {
  font-size: 26rpx;
  color: #475569;
  line-height: 1.6;
  margin-bottom: 24rpx;
  padding: 16rpx;
  background: #f8fafc;
  border-radius: 12rpx;
}

.list-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.list-item:last-child {
  border-bottom: none;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #112132;
}

.difficulty-tag {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.difficulty-easy {
  background: #ecfdf5;
  color: #047857;
}

.difficulty-medium {
  background: #fef3c7;
  color: #92400e;
}

.difficulty-hard {
  background: #fef2f2;
  color: #b91c1c;
}

.item-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.info-text {
  font-size: 24rpx;
  color: #64748b;
}

.info-text.highlight {
  color: #0f766e;
  font-weight: 600;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 48rpx 0;
}

.empty-text {
  font-size: 30rpx;
  color: #64748b;
  display: block;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #94a3b8;
  display: block;
}
