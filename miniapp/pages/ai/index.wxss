@import "../../app.wxss";


/* ==== AI 聊天气泡（追加） ==== */
.chat-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 18rpx;
}
.chat-bubble {
  max-width: 86%;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  line-height: 1.6;
  font-size: 28rpx;
}
.bubble-role {
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 6rpx;
}
.bubble-content {
  white-space: pre-wrap;
  word-break: break-word;
}
.bubble-user {
  align-self: flex-end;
  background: #0f766e;
  color: #fff;
  border-bottom-right-radius: 4rpx;
}
.bubble-user .bubble-role { color: rgba(255,255,255,.7); }
.bubble-ai {
  align-self: flex-start;
  background: #f1f5f9;
  color: #0f172a;
  border-bottom-left-radius: 4rpx;
}
