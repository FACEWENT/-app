@import "../../app.wxss";


/* ==== AI 聊天气泡（追加） ==== */
.chat-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 18rpx;
}
.chat-bubble {
  max-width: 86%;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  line-height: 1.6;
  font-size: 28rpx;
}
.bubble-role {
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 6rpx;
}
.bubble-content {
  white-space: pre-wrap;
  word-break: break-word;
}
.bubble-user {
  align-self: flex-end;
  background: #0f766e;
  color: #fff;
  border-bottom-right-radius: 4rpx;
}
.bubble-user .bubble-role { color: rgba(255,255,255,.7); }
.bubble-ai {
  align-self: flex-start;
  background: #f1f5f9;
  color: #0f172a;
  border-bottom-left-radius: 4rpx;
}


/* ==== AI 思考过程（追加） ==== */
.thinking-box {
  margin-top: 8rpx;
  margin-bottom: 14rpx;
  background: rgba(15, 118, 110, 0.06);
  border: 1rpx solid rgba(15, 118, 110, 0.18);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
}
.thinking-header {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #0f766e;
}
.thinking-icon { margin-right: 8rpx; }
.thinking-title { flex: 1; font-weight: 500; }
.thinking-toggle { color: #94a3b8; font-size: 22rpx; }
.thinking-list {
  margin-top: 10rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  border-top: 1rpx dashed rgba(15, 118, 110, 0.2);
  padding-top: 10rpx;
}
.thinking-item {
  display: flex;
  align-items: flex-start;
  font-size: 24rpx;
  line-height: 1.5;
}
.thinking-status {
  margin-right: 10rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}
.status-running { color: #f59e0b; }
.status-done { color: #16a34a; }
.thinking-detail { flex: 1; min-width: 0; }
.thinking-name {
  font-family: monospace, ui-monospace;
  color: #0f172a;
  font-size: 24rpx;
  word-break: break-all;
}
.thinking-summary {
  margin-top: 4rpx;
  color: #64748b;
  font-size: 22rpx;
}

/* ==== 流式光标 ==== */
.bubble-cursor {
  display: inline-block;
  margin-left: 2rpx;
  color: #0f766e;
  font-weight: 700;
  animation: blink 1s steps(1) infinite;
}
.bubble-user .bubble-cursor { color: #fff; }
@keyframes blink {
  0%, 50% { opacity: 1; }
  50.01%, 100% { opacity: 0; }
}
