<view class="page">
  <view class="form">
    <!-- 标题 -->
    <view class="form-item">
      <text class="label">标题</text>
      <input class="input" placeholder="请输入标题，如：数学一对一辅导" value="{{title}}" bindinput="onInputTitle" maxlength="50"/>
    </view>

    <!-- 教学科目 -->
    <view class="form-item">
      <text class="label">教学科目</text>
      <view class="radio-group">
        <view class="radio {{subjectType === 'math' ? 'active' : ''}}" bindtap="onSelectSubject" data-type="math">数学</view>
        <view class="radio {{subjectType === 'english' ? 'active' : ''}}" bindtap="onSelectSubject" data-type="english">英语</view>
        <view class="radio {{subjectType === 'politics' ? 'active' : ''}}" bindtap="onSelectSubject" data-type="politics">政治</view>
        <view class="radio {{subjectType === 'professional' ? 'active' : ''}}" bindtap="onSelectSubject" data-type="professional">专业课</view>
      </view>
    </view>

    <!-- 科目分数 -->
    <view class="form-item">
      <text class="label">考研分数（该科目）</text>
      <input class="input" type="number" placeholder="请输入该科目考研分数" value="{{subjectScore}}" bindinput="onInputSubjectScore"/>
    </view>

    <!-- 就读学校 -->
    <view class="form-item">
      <text class="label">就读学校</text>
      <input class="input" placeholder="请输入你就读的学校" value="{{currentSchool}}" bindinput="onInputSchool"/>
    </view>

    <!-- 就读专业 -->
    <view class="form-item">
      <text class="label">就读专业</text>
      <input class="input" placeholder="请输入你就读的专业" value="{{currentMajor}}" bindinput="onInputMajor"/>
    </view>

    <!-- 授课方式 -->
    <view class="form-item">
      <text class="label">授课方式</text>
      <view class="radio-group">
        <view class="radio {{teachingMode === 'online' ? 'active' : ''}}" bindtap="onSelectMode" data-mode="online">线上</view>
        <view class="radio {{teachingMode === 'offline' ? 'active' : ''}}" bindtap="onSelectMode" data-mode="offline">线下</view>
        <view class="radio {{teachingMode === 'both' ? 'active' : ''}}" bindtap="onSelectMode" data-mode="both">线上线下均可</view>
      </view>
    </view>

    <!-- 价格 -->
    <view class="form-item">
      <text class="label">价格（元）</text>
      <input class="input" type="digit" placeholder="请输入价格，如每小时费用" value="{{price}}" bindinput="onInputPrice"/>
    </view>

    <!-- 个人介绍 -->
    <view class="form-item">
      <text class="label">个人介绍</text>
      <textarea class="textarea" placeholder="请介绍你的教学经验、优势等" value="{{content}}" bindinput="onInputContent" maxlength="500"/>
      <text class="char-count">{{content.length}}/500</text>
    </view>

    <!-- 联系方式 -->
    <view class="form-item">
      <text class="label">联系方式（可选）</text>
      <input class="input" placeholder="微信号、手机号等" value="{{contactInfo}}" bindinput="onInputContact"/>
    </view>

    <!-- 提交按钮 -->
    <button class="submit-btn" bindtap="onSubmit" disabled="{{submitting}}">
      {{submitting ? '发布中...' : '发布'}}
    </button>
  </view>
</view>
