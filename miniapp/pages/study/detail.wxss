.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.detail-card {
  background: #fff;
  margin-bottom: 20rpx;
}

.image-swiper {
  width: 100%;
  height: 500rpx;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

.info-section {
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
}

.price {
  font-size: 48rpx;
  font-weight: bold;
  color: #ff4757;
}

.original-price {
  font-size: 28rpx;
  color: #999;
  text-decoration: line-through;
}

.condition {
  padding: 8rpx 20rpx;
  background: #fff3e0;
  color: #ff9800;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.location-row {
  padding: 20rpx 30rpx;
  font-size: 26rpx;
  color: #666;
  border-bottom: 1rpx solid #f5f5f5;
}

.content-section {
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.tags-section {
  padding: 20rpx 30rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.tag {
  padding: 8rpx 20rpx;
  background: #f0f0f0;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666;
}

.contact-section {
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.contact {
  font-size: 28rpx;
  color: #667eea;
  font-weight: 500;
}

.user-section {
  padding: 30rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f5f5f5;
}

.user-name {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.view-count {
  font-size: 24rpx;
  color: #999;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: 40rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.1);
  gap: 20rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 30rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  background: #f5f5f5;
}

.like-btn.liked {
  background: #ffe0e0;
}

.chat-btn {
  flex: 1;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.loading {
  text-align: center;
  padding: 100rpx;
  color: #999;
  font-size: 28rpx;
}
