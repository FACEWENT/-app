.payment-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
  padding: 30rpx;
}

.payment-card {
  background: #fff;
  border-radius: 30rpx;
  padding: 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.1);
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.header .icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.header .title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.header .subtitle {
  font-size: 26rpx;
  color: #999;
}

.order-info {
  background: #f8f9fa;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.order-info .row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 0;
}

.order-info .row:not(:last-child) {
  border-bottom: 1rpx solid #eee;
}

.order-info .label {
  font-size: 28rpx;
  color: #666;
}

.order-info .value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.price-section {
  text-align: center;
  padding: 40rpx 0;
  border-top: 1rpx solid #eee;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 30rpx;
}

.price-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.price {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.price .symbol {
  font-size: 40rpx;
  color: #667eea;
  margin-right: 5rpx;
}

.price .amount {
  font-size: 80rpx;
  color: #667eea;
  font-weight: bold;
}

.features {
  margin-bottom: 40rpx;
}

.feature {
  display: flex;
  align-items: center;
  padding: 15rpx 0;
}

.feature .check {
  width: 40rpx;
  height: 40rpx;
  background: #52c41a;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin-right: 20rpx;
}

.feature .text {
  font-size: 28rpx;
  color: #333;
}

.pay-btn {
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 50rpx;
  height: 90rpx;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.pay-btn::after {
  border: none;
}

.tips {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 20rpx 0;
}
