.matching-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  padding: 60rpx 40rpx;
}

/* 星球旋转动画 */
.planet-animation {
  position: relative;
  width: 500rpx;
  height: 500rpx;
  margin: 0 auto 80rpx;
}

.center-planet {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #667eea, #764ba2);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 60rpx rgba(102, 126, 234, 0.6);
  animation: float 3s ease-in-out infinite;
}

.planet-core {
  font-size: 80rpx;
}

.orbit {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.orbit-1 {
  width: 300rpx;
  height: 300rpx;
  animation: orbit-rotate 8s linear infinite;
}

.orbit-2 {
  width: 400rpx;
  height: 400rpx;
  animation: orbit-rotate 12s linear infinite reverse;
}

.orbit-3 {
  width: 480rpx;
  height: 480rpx;
  animation: orbit-rotate 16s linear infinite;
}

.orbit-dot {
  position: absolute;
  top: -15rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 40rpx;
  animation: dot-pulse 2s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translate(-50%, -50%) translateY(0); }
  50% { transform: translate(-50%, -50%) translateY(-20rpx); }
}

@keyframes orbit-rotate {
  from { transform: translate(-50%, -50%) rotate(0deg); }
  to { transform: translate(-50%, -50%) rotate(360deg); }
}

@keyframes dot-pulse {
  0%, 100% { opacity: 0.5; transform: translateX(-50%) scale(1); }
  50% { opacity: 1; transform: translateX(-50%) scale(1.2); }
}

/* 状态文字 */
.status-section {
  text-align: center;
  margin-bottom: 50rpx;
}

.main-text {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 15rpx;
  text-shadow: 0 0 20rpx rgba(102, 126, 234, 0.8);
}

.sub-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 进度条 */
.progress-container {
  margin-bottom: 50rpx;
}

.progress-bar {
  width: 100%;
  height: 16rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 15rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea, #764ba2);
  border-radius: 8rpx;
  transition: width 0.3s ease;
  box-shadow: 0 0 10rpx rgba(102, 126, 234, 0.8);
}

.progress-percent {
  text-align: center;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 匹配维度 */
.match-dimensions {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 30rpx;
  padding: 30rpx;
  margin-bottom: 50rpx;
}

.dimension-item {
  display: flex;
  align-items: center;
  padding: 25rpx 0;
}

.dimension-item:not(:last-child) {
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.dimension-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.dimension-name {
  flex: 1;
  font-size: 28rpx;
  color: #fff;
}

.dimension-status {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.dimension-status.pending {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.4);
}

.dimension-status.matching {
  background: rgba(102, 126, 234, 0.3);
  color: #667eea;
  animation: spin 1s linear infinite;
}

.dimension-status.done {
  background: #52c41a;
  color: #fff;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 提示文字 */
.tips-text {
  text-align: center;
  margin-bottom: 80rpx;
}

.tips-text text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 取消按钮 */
.cancel-btn {
  text-align: center;
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50rpx;
}

.cancel-btn text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

.cancel-btn:active {
  background: rgba(255, 255, 255, 0.15);
}
