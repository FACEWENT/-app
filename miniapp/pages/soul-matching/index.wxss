.soul-matching-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  padding-bottom: 40rpx;
}

/* 星球动画区 */
.planet-container {
  position: relative;
  height: 500rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.planet {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #667eea, #764ba2);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: float 3s ease-in-out infinite;
}

.planet-glow {
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(102, 126, 234, 0.3), transparent);
  animation: pulse 2s ease-in-out infinite;
}

.planet-ring {
  position: absolute;
  width: 280rpx;
  height: 60rpx;
  border: 4rpx solid rgba(102, 126, 234, 0.5);
  border-radius: 50%;
  transform: rotate(-20deg);
  animation: rotate 10s linear infinite;
}

.planet-icon {
  font-size: 100rpx;
  z-index: 10;
}

.planet-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-top: 40rpx;
  text-shadow: 0 0 20rpx rgba(102, 126, 234, 0.8);
}

.planet-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 15rpx;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 0.5; }
  50% { transform: scale(1.1); opacity: 0.8; }
}

@keyframes rotate {
  from { transform: rotate(-20deg); }
  to { transform: rotate(340deg); }
}

/* 匹配按钮区 */
.match-buttons {
  padding: 0 40rpx;
  margin-bottom: 40rpx;
}

.match-btn {
  position: relative;
  border-radius: 30rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
}

.free-match {
  background: linear-gradient(135deg, #00b4db, #0083b0);
  box-shadow: 0 10rpx 40rpx rgba(0, 180, 219, 0.4);
}

.free-match:active {
  transform: scale(0.98);
}

.premium-match {
  background: linear-gradient(135deg, #f093fb, #f5576c);
  box-shadow: 0 10rpx 40rpx rgba(245, 87, 108, 0.4);
}

.premium-match:active {
  transform: scale(0.98);
}

.btn-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.btn-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.btn-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.btn-glow {
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.1), transparent);
  animation: glow 3s ease-in-out infinite;
}

@keyframes glow {
  0%, 100% { transform: translate(0, 0); }
  50% { transform: translate(10%, 10%); }
}

.btn-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: rgba(255, 255, 255, 0.3);
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: bold;
}

/* 特色功能 */
.features {
  display: flex;
  justify-content: space-around;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.feature-icon {
  font-size: 50rpx;
  margin-bottom: 10rpx;
}

.feature-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 匹配记录 */
.match-history {
  background: rgba(255, 255, 255, 0.1);
  margin: 0 30rpx 30rpx;
  border-radius: 20rpx;
  padding: 30rpx;
}

.history-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.history-item {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.05);
  padding: 20rpx;
  border-radius: 15rpx;
}

.history-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.history-info {
  flex: 1;
}

.history-name {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.history-detail {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.history-status {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.history-status.pending {
  background: rgba(255, 193, 7, 0.2);
  color: #ffc107;
}

.history-status.accepted {
  background: rgba(76, 175, 80, 0.2);
  color: #4caf50;
}

.history-status.rejected {
  background: rgba(244, 67, 54, 0.2);
  color: #f44336;
}

/* 使用说明 */
.usage-tips {
  background: rgba(255, 255, 255, 0.05);
  margin: 0 30rpx;
  border-radius: 20rpx;
  padding: 30rpx;
}

.tips-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
}

.tips-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.tip-item {
  display: flex;
  flex-direction: column;
}

.tip-label {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.tip-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.5;
}
