.result-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
  padding: 30rpx;
}

.result-card {
  background: #fff;
  border-radius: 30rpx;
  padding: 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.1);
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.success-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.header .title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.header .subtitle {
  font-size: 26rpx;
  color: #999;
}

.match-score {
  text-align: center;
  margin-bottom: 40rpx;
}

.score-circle {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
}

.score {
  font-size: 60rpx;
  color: #fff;
  font-weight: bold;
}

.score-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.user-info {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: #f8f9fa;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 30rpx;
}

.user-details {
  flex: 1;
}

.nickname {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.info {
  font-size: 26rpx;
  color: #666;
}

.match-details {
  background: #f8f9fa;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
}

.detail-row:not(:last-child) {
  border-bottom: 1rpx solid #eee;
}

.detail-row .label {
  font-size: 28rpx;
  color: #666;
}

.detail-row .value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.bio-section {
  margin-bottom: 30rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.bio {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.actions {
  margin-top: 40rpx;
}

.accept-btn {
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 50rpx;
  height: 90rpx;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.accept-btn::after {
  border: none;
}

.reject-btn {
  background: #fff;
  color: #667eea;
  border: 2rpx solid #667eea;
  border-radius: 50rpx;
  height: 90rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.reject-btn::after {
  border: none;
}
