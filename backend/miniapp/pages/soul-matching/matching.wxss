.matching-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.animation-container {
  width: 100%;
  padding: 60rpx 40rpx;
}

.circle-animation {
  position: relative;
  width: 400rpx;
  height: 400rpx;
  margin: 0 auto 60rpx;
}

.outer-circle,
.inner-circle,
.core-circle {
  position: absolute;
  border-radius: 50%;
}

.outer-circle {
  width: 400rpx;
  height: 400rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
  border-top-color: #fff;
  animation: spin 2s linear infinite;
}

.inner-circle {
  width: 300rpx;
  height: 300rpx;
  top: 50rpx;
  left: 50rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-bottom-color: #fff;
  animation: spin-reverse 1.4s linear infinite;
}

.core-circle {
  width: 200rpx;
  height: 200rpx;
  top: 100rpx;
  left: 100rpx;
  background: rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: pulse 1.5s ease-in-out infinite;
}

.loading-icon {
  font-size: 100rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes spin-reverse {
  from { transform: rotate(360deg); }
  to { transform: rotate(0deg); }
}

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 0.8; }
  50% { transform: scale(1.1); opacity: 1; }
}

.progress-info {
  text-align: center;
  margin-bottom: 40rpx;
}

.status-text {
  display: block;
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 30rpx;
}

.progress-bar {
  width: 100%;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 15rpx;
}

.progress-fill {
  height: 100%;
  background: #fff;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.matching-tips {
  text-align: center;
  margin-bottom: 50rpx;
}

.tip {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.dimensions {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 30rpx;
  padding: 30rpx;
}

.dimension-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.dimension-item:not(:last-child) {
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.dimension-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.dimension-name {
  flex: 1;
  font-size: 28rpx;
  color: #fff;
}

.dimension-status {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.dimension-status.pending {
  background: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.5);
}

.dimension-status.matching {
  background: rgba(255, 255, 255, 0.3);
  color: #fff;
  animation: spin 1s linear infinite;
}

.dimension-status.done {
  background: #52c41a;
  color: #fff;
}
